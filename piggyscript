local hintBlinkThread, hintFadeThread = nil, nil
local function showHint()
    HintLabel.Text = "Нажмите " .. (Binds.Menu and Binds.Menu.Name or "клавишу") .. " чтобы открыть"
    HintLabel.Visible = true
    HintLabel.BackgroundTransparency = 0.2
    HintLabel.TextTransparency = 0 
    HintStroke.Transparency = 0.1
    
    if hintBlinkThread then task.cancel(hintBlinkThread) end
    hintBlinkThread = task.spawn(function()
        while HintLabel.Visible do
            tween(HintStroke, {Transparency = 0.8, Color = Color3.fromRGB(130, 160, 255)}, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut))
            task.wait(1)
            if not HintLabel.Visible then break end
            tween(HintStroke, {Transparency = 0.1, Color = Color3.fromRGB(80, 120, 255)}, TweenInfo.new(1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut))
            task.wait(1)
        end
    end)
    
    if hintFadeThread then task.cancel(hintFadeThread) end
    hintFadeThread = task.spawn(function()
        task.wait(5)
        if not HintLabel.Visible then return end
        tween(HintLabel, {BackgroundTransparency = 1, TextTransparency = 1}, TweenInfo.new(1.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out))
        tween(HintStroke, {Transparency = 1}, TweenInfo.new(1.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out))
        task.wait(1.5)
        HintLabel.Visible = false
    end)
end

