    local camC = cam.CFrame; local camLook = camC.LookVector; local camRight = camC.RightVector; local move = hum.MoveDirection or Vector3.new(0,0,0)
    local horizForward = Vector3.new(camLook.X, 0, camLook.Z).Unit; local horizRight = Vector3.new(camRight.X, 0, camRight.Z).Unit
    local forwardInput = Vector3.new(move.X,0,move.Z):Dot(horizForward); local rightInput = Vector3.new(move.X,0,move.Z):Dot(horizRight)
    local dir = (camLook * forwardInput) + (camRight * rightInput)
