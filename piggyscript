-- FREECAM
local isFreecam = false
local freecamSpeed = 50
local freecamBindName = "PigAhubFreecam"
local camYaw, camPitch = 0, 0
local function toggleFreecam(state)
    isFreecam = state
    local cam = workspace.CurrentCamera
    if state then
        cam.CameraType = Enum.CameraType.Scriptable
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
        UserInputService.MouseIconEnabled = false
        local c = cam.CFrame; camPitch, camYaw, _ = c:ToEulerAnglesYXZ()
        RunService:BindToRenderStep(freecamBindName, Enum.RenderPriority.Camera.Value + 1, function(dt)
            if not isFreecam then return end
            local delta = UserInputService:GetMouseDelta()
            if delta.Magnitude > 0 then
                local sens = 0.005
                camPitch = math.clamp(camPitch - delta.Y * sens, -math.pi/2 + 0.1, math.pi/2 - 0.1)
                camYaw = camYaw - delta.X * sens
            end
            local moveVec = Vector3.new(0,0,0)
            local look = CFrame.fromEulerAnglesYXZ(camPitch, camYaw, 0).LookVector
            local right = CFrame.fromEulerAnglesYXZ(camPitch, camYaw, 0).RightVector
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveVec += look end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveVec -= look end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveVec -= right end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveVec += right end
            local newPos = cam.CFrame.Position + (moveVec.Unit * freecamSpeed * dt)
            if moveVec.Magnitude == 0 then newPos = cam.CFrame.Position end
            cam.CFrame = CFrame.new(newPos) * CFrame.fromEulerAnglesYXZ(camPitch, camYaw, 0)
        end)
        showToast("Freecam ВКЛ", true)
    else
        RunService:UnbindFromRenderStep(freecamBindName)
        UserInputService.MouseBehavior = Enum.MouseBehavior.Default
        UserInputService.MouseIconEnabled = true
        cam.CameraType = Enum.CameraType.Custom
        local char = player.Character
        if char and char:FindFirstChild("HumanoidRootPart") then cam.CFrame = char.HumanoidRootPart.CFrame end
        showToast("Freecam ВЫКЛ", false)
    end
end
