UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if bindingFeature then
        if input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode ~= Enum.KeyCode.Escape then Binds[bindingFeature] = input.KeyCode else Binds[bindingFeature] = nil end
        if bindingFeature == "Menu" then menuBtnRef.Text = Binds.Menu and Binds.Menu.Name or "Нет"; updateFcWarning()
        elseif bindingFeature == "Fly" then flyBtnRef.Text = Binds.Fly and Binds.Fly.Name or "Нет"
        elseif bindingFeature == "Noclip" then noclipBtnRef.Text = Binds.Noclip and Binds.Noclip.Name or "Нет"
        elseif bindingFeature == "Godmode" then godBtnRef.Text = Binds.Godmode and Binds.Godmode.Name or "Нет"
        elseif bindingFeature == "Freecam" then freecamBtnRef.Text = Binds.Freecam and Binds.Freecam.Name or "Нет" end
        bindingFeature = nil; return
    end
    if gameProcessed then return end
    if input.KeyCode == Binds.Menu then
        SettingsUI.Visible = false; ModalBlur.Visible = false; Main.Visible = not Main.Visible; Shadow.Visible = Main.Visible
        if Main.Visible then
            HintLabel.Visible = false; if hintFadeThread then task.cancel(hintFadeThread) end; if hintBlinkThread then task.cancel(hintBlinkThread) end
        else showHint() end
    end
    if Binds.Fly and input.KeyCode == Binds.Fly and toggleFlyUI then toggleFlyUI() end
    if Binds.Noclip and input.KeyCode == Binds.Noclip and toggleNoclipUI then toggleNoclipUI() end
    if Binds.Godmode and input.KeyCode == Binds.Godmode and toggleGodUI then toggleGodUI() end
    if Binds.Freecam and input.KeyCode == Binds.Freecam and toggleFreecamUI then toggleFreecamUI() end
    if input.KeyCode == Enum.KeyCode.Space and infJumpEnabled then
        local char = player.Character; if char then local hum = char:FindFirstChildOfClass("Humanoid"); if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end end
    end
end)

