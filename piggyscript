local isResizing = false
local startSize, startMouse = Vector2.new(), Vector2.new()

ResizeHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isResizing = true
        startSize = Vector2.new(Main.AbsoluteSize.X, Main.AbsoluteSize.Y)
        startMouse = Vector2.new(input.Position.X, input.Position.Y)
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if isResizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local deltaX = input.Position.X - startMouse.X
        local deltaY = input.Position.Y - startMouse.Y
        local newWidth = math.clamp(startSize.X + deltaX, 450, 1000)
        local newHeight = math.clamp(startSize.Y + deltaY, 300, 800)
        Main.Size = UDim2.new(0, newWidth, 0, newHeight)
        Shadow.Size = UDim2.new(0, newWidth + 20, 0, newHeight + 20)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then isResizing = false end
end)

