local function showToast(message, state)
    if not Settings.Notifications then return end
    local toast = Instance.new("Frame")
    toast.Size = UDim2.new(1, 0, 0, 40)
    toast.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    toast.BackgroundTransparency = 0.1
    toast.ZIndex = 100
    toast.Parent = ToastContainer
    Instance.new("UICorner", toast).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", toast)
    stroke.Thickness = 2
    stroke.Color = state == true and Color3.fromRGB(80, 220, 120) or (state == false and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(80, 120, 255))
    
    local lbl = Instance.new("TextLabel", toast)
    lbl.Size = UDim2.new(1, -20, 1, 0)
    lbl.Position = UDim2.new(0, 10, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = message
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.ZIndex = 101

    task.spawn(function()
        while toast.Parent do
            tween(stroke, {Transparency = 0.7}, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut))
            task.wait(0.6)
            if not toast.Parent then break end
            tween(stroke, {Transparency = 0}, TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut))
            task.wait(0.6)
        end
    end)
    toast.Position = UDim2.new(1, 20, 0, 0)
    tween(toast, {Position = UDim2.new(0, 0, 0, 0)}, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out))
    task.spawn(function()
        task.wait(3)
        tween(toast, {Position = UDim2.new(1, 20, 0, 0), BackgroundTransparency = 1}, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In))
        task.wait(0.3)
        toast:Destroy()
    end)
end

