FovTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        fovDragging = true
        local rel = math.clamp((input.Position.X - FovTrack.AbsolutePosition.X) / FovTrack.AbsoluteSize.X, 0, 1)
        currentFov = math.floor(rel * (120 - 70)) + 70; Settings.FOV = currentFov; updateFovVisuals(currentFov); FovInput.Text = tostring(currentFov); SaveSettings()
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if fovDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local rel = math.clamp((input.Position.X - FovTrack.AbsolutePosition.X) / FovTrack.AbsoluteSize.X, 0, 1)
        currentFov = math.floor(rel * (120 - 70)) + 70; Settings.FOV = currentFov; updateFovVisuals(currentFov); FovInput.Text = tostring(currentFov); SaveSettings()
    end
end)
UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then fovDragging = false end end)
FovInput.FocusLost:Connect(function()
    local num = tonumber(FovInput.Text)
    if num then num = math.clamp(num, 70, 120); currentFov = num; Settings.FOV = num; updateFovVisuals(num); FovInput.Text = tostring(num); SaveSettings() else FovInput.Text = tostring(currentFov) end
